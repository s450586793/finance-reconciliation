DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
# 填写外部访问主机；Compose 会自动加入内部服务名 web。
DJANGO_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# 生产环境保持 true；仅在明确接受明文传输风险的临时 HTTP 部署中设为 false。
DJANGO_COOKIE_SECURE=true
# 必填：生产单位真实纳税人识别号，用于判定进项与销项；不要填写公开示例值。
COMPANY_TAX_ID=
FINREC_APP_DIR=/volume4/docker/docker/finance-reconciliation/app
FINREC_DATA_DIR=/volume4/docker/docker/finance-reconciliation/data
FINREC_WEB_IMAGE_TAG=v0.0.0
FINREC_UPDATER_IMAGE_TAG=v0.0.0
FINREC_UPDATER_TOKEN=
IMPORT_MAX_UPLOAD_BYTES=20971520
IMPORT_MAX_ROWS=100000
DATABASE_URL=
POSTGRES_DB=finance_reconciliation
POSTGRES_USER=finance
POSTGRES_PASSWORD=
